# Copy to backend/.env and fill in real values.
# Never commit backend/.env

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alphabet_game
DB_USER=alphabet
DB_PASS=change-me

# Comma-separated origins allowed to call the API (GitHub Pages + local)
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://shezataha.github.io

# Session token lifetime in seconds (default 30 days)
SESSION_TTL=2592000

# App environment: local | staging | production
APP_ENV=local